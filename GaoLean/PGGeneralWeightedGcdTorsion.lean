#print axioms GaoLean.mem_weightedDifferenceKernel_iff_singletonLocus
#print axioms GaoLean.mem_weightedDifferenceKernel_iff_weightedValueBlock_card_eq_one
#print axioms GaoLean.quotientLayer_weightedValueBlock_card_eq_one
#print axioms GaoLean.weightedDifferenceQuotientEquivRange
#print axioms GaoLean.weightedBaseWeightKernelHom_injective
